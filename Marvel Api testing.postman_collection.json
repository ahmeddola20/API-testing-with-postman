	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"// Import CryptoJS library for MD5 hashing\r",
					"const CryptoJS = require('crypto-js');\r",
					"\r",
					"// Generate a timestamp (current time)\r",
					"let ts = \"1\";\r",
					"\r",
					"// Get the public and private API keys from Postman environment variables\r",
					"let publicKey = pm.environment.get(\"public_key\");\r",
					"let privateKey = pm.environment.get(\"private_key\");\r",
					"\r",
					"// Generate the hash (MD5 of ts + privateKey + publicKey)\r",
					"let hash = CryptoJS.MD5(ts + privateKey + publicKey).toString();\r",
					"\r",
					"// Set the timestamp and hash as environment variables to be used in the request\r",
					"pm.environment.set(\"ts\", ts);\r",
					"pm.environment.set(\"hash\", hash);"
				]
			}
		},
