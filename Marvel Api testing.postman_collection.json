		{
			"name": "comics",
			"item": [
				{
					"name": "Fetches lists of comics",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Extract IDs from results and save\", function () {\r",
									"    let responseData = pm.response.json();\r",
									"    let ids = [];\r",
									"\r",
									"    if (responseData.data && responseData.data.results && Array.isArray(responseData.data.results)) {\r",
									"        responseData.data.results.forEach(function (result) {\r",
									"            ids.push(result.id); // Extract the IDs from the array\r",
									"        });\r",
									"\r",
									"        // Save the extracted IDs as a JSON string in an environment variable\r",
									"        pm.environment.set(\"extractedcomicsIDs\", JSON.stringify(ids));\r",
									"    } else {\r",
									"        console.log(\"Results array not found.\");\r",
									"    }\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
