			"name": "characters",
			"item": [
				{
					"name": "Fetches lists of characters",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Extract IDs from results\", function () {\r",
									"    // Parse the response body as JSON\r",
									"    let responseData = pm.response.json();\r",
									"\r",
									"    // Check if the 'results' array exists in the response\r",
									"    if (responseData.data && responseData.data.results && Array.isArray(responseData.data.results)) {\r",
									"        // Loop through the results array\r",
									"        responseData.data.results.forEach(function (result) {\r",
									"            // Log each ID to the console\r",
									"            console.log(\"Extracted ID:\", result.id);\r",
									"        });\r",
									"    } else {\r",
									"        console.log(\"Results array not found in the response.\");\r",
									"    }\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
